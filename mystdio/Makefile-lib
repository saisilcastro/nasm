NAME = coderio.a
OBJ = obj
INCLUDE = -I./include

SRC_ASM = $(notdir $(wildcard asm-src/*.s))
SRC_C = $(wildcard *.c)

ASMOBJS = $(patsubst %.s,$(OBJ)/%.o,$(SRC_ASM))
COBJS = $(patsubst %.c,$(OBJ)/%.o,$(SRC_C))
SRCOBJS = $(ASMOBJS) $(COBJS)

AS = nasm
CC = gcc
AR = ar
ARFLAGS = rcs
CFLAGS = -c -Wall -Wextra -std=c11

VPATH = .:asm-src

ifeq ($(OS),Windows_NT)
    ASFLAGS = -f win64
    CREATE = mkdir -p $(1)
    REMOVE_DIR = rm -rf $(1)
    REMOVE_FILE = rm -f $(1)
else
    ASFLAGS = -f elf64
    CREATE = mkdir -p $(1)
    REMOVE_DIR = rm -rf $(1)
    REMOVE_FILE = rm -f $(1)
endif

.PHONY: all clean fclean re

all: $(NAME)

$(NAME): $(SRCOBJS)
	@echo Creating library $@
	@$(AR) $(ARFLAGS) $@ $(SRCOBJS)

$(OBJ)/%.o: %.s | $(OBJ)
	@echo Generating $@ from $<
	@$(AS) $< $(ASFLAGS) -o $@

$(OBJ)/%.o: %.c | $(OBJ)
	@echo Creating $@ from $<
	@$(CC) $< $(CFLAGS) -o $@ $(INCLUDE)

$(OBJ):
	@$(call CREATE,$(OBJ))

clean:
	@$(call REMOVE_DIR,$(OBJ))

fclean: clean
	@$(call REMOVE_FILE,$(NAME))

re: fclean all
